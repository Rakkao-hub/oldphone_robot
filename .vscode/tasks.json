{
  // กด Cmd+Shift+B เพื่อส่งโค้ดขึ้นมือถือ (VS Code บันทึกไฟล์ที่ยังไม่ save ให้ก่อน)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "อัปเข้ามือถือ",
      "type": "shell",
      "command": "${workspaceFolder}/deploy.sh",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "ดู log ของแซน",
      "type": "shell",
      "command": "ssh phone 'tail -n 30 -f ~/robot/brain.log'",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
